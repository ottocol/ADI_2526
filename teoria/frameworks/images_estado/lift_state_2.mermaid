graph TD
    A[App] --> B[ListaCompra]
    A --> D[Panel]
    B --> C1[Item #1]
    B --> C2[Item #2]
    B --> C3[Resumen]
    D --> E1[Menú]
    D --> E2[Datos <br/> usuario]

    %% Indicaciones visuales
    classDef state fill:#ffecb3,stroke:#d4a017,stroke-width:2px;
    classDef normal fill:#e8e8e8,stroke:#999,stroke-width:1px;

    class A,B,C1,C2,C3,D,E1,E2 normal;
    class B state;